                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": { "name": "${datasource}" },
                      "spec": { "query": "pumpRuns = from(bucket: \"irrigation\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"irrigation\" and r._field == \"pump_runtime_s\")\n  |> filter(fn: (r) => r._value > 0)\n\nskipEvents = from(bucket: \"irrigation\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"irrigation\" and r._field == \"skip_reason\")\n  |> filter(fn: (r) => r._value != \"not_time\" and r._value != \"none\" and r._value != \"already_watered\")\n\nunion(tables: [pumpRuns, skipEvents])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n  |> rename(columns: {_time: \"Time\", _field: \"Event\", _value: \"Value\"})" }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "footer": { "show": false },
                "sortBy": [{ "desc": true, "displayName": "Time" }]
              },
              "fieldConfig": {
                "defaults": { "custom": { "align": "auto" } },
                "overrides": [
                  {
                    "matcher": { "id": "byName", "options": "Value" },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          { "options": { "empty_butt":      { "color": "orange", "text": "⚠ Water low"       } }, "type": "value" },
                          { "options": { "low_battery":     { "color": "red",    "text": "🔋 Low battery"    } }, "type": "value" },
                          { "options": { "rain":            { "color": "blue",   "text": "🌧 Rain forecast"  } }, "type": "value" },
                          { "options": { "frost":           { "color": "blue",   "text": "❄ Frost warning"  } }, "type": "value" },
                          { "options": { "no_weather_data": { "color": "orange", "text": "⚠ No weather data" } }, "type": "value" },
                          { "options": { "time_unknown":    { "color": "orange", "text": "⚠ Time unknown"    } }, "type": "value" }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
